<?xml version="1.0" encoding="utf-8"?>
<!--
  Vision (Android nativa). La version la pone build.sh (git) con aapt2 replace-version.
  Lo marcado ARCORE se copia del manifest del AAR de ARCore 1.57.0: al subir de version,
  volver a compararlo (third_party/arcore/VERSION/AndroidManifest.xml).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.frost.vision">

  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
  <uses-feature android:glEsVersion="0x00030001" android:required="true" />

  <!-- ARCORE: consultas que exige el SDK para instalar o actualizar ARCore -->
  <queries>
    <package android:name="com.google.ar.core" />
    <package android:name="com.android.vending" />
    <intent>
      <action android:name="com.google.android.play.core.install.BIND_INSTALL_SERVICE" />
    </intent>
  </queries>

  <application
      android:label="@string/app_name"
      android:icon="@drawable/ic_launcher"
      android:theme="@style/AppTheme"
      android:allowBackup="false"
      android:extractNativeLibs="true"
      android:hardwareAccelerated="true">

    <!-- La app no tiene sentido sin AR: ARCore requerido -->
    <meta-data android:name="com.google.ar.core" android:value="required" />
    <!-- ARCORE: version minima del APK de ARCore para este SDK -->
    <meta-data android:name="com.google.ar.core.min_apk_version" android:value="262070000" />
    <!-- ARCORE: instala ARCore si falta -->
    <activity
        android:name="com.google.ar.core.InstallActivity"
        android:configChanges="keyboardHidden|orientation|screenSize"
        android:excludeFromRecents="true"
        android:exported="false"
        android:launchMode="singleTop"
        android:theme="@android:style/Theme.Material.Light.Dialog.Alert" />

    <activity
        android:name=".ui.HomeActivity"
        android:exported="true"
        android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- abrir .glb / .html compartidos (escaneos de la web o de otra instalacion) -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="model/gltf-binary" />
      </intent-filter>
    </activity>

    <activity
        android:name=".ui.ScanActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden" />

    <activity
        android:name=".ui.ViewerActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden" />

    <activity
        android:name=".ui.DiagActivity"
        android:exported="false"
        android:screenOrientation="portrait" />

    <!-- Pruebas en el dispositivo (GPU contra CPU, tiempos): adb shell am start -n org.frost.vision/.ui.TestsActivity -->
    <activity
        android:name=".ui.TestsActivity"
        android:exported="true"
        android:screenOrientation="portrait" />

    <provider
        android:name=".store.ShareProvider"
        android:authorities="org.frost.vision.share"
        android:exported="false"
        android:grantUriPermissions="true" />
  </application>
</manifest>
